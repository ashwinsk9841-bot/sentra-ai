# SENTRA AI - backend environment
#
# Copy to `.env` for local development:
#     copy .env.example .env
#
# This file is read by the Python backend only. The browser never sees any of
# these values: the Next.js route handler at frontend/src/app/api/[...path]
# proxies /api/* to the backend and returns only the JSON payload.
#
# In production set these as server-side environment variables on the backend
# host (Render/Railway/Fly), not in the frontend project.

# --------------------------------------------------------------------------- #
# Persistence - Supabase (production) / SQLite (local fallback)
# --------------------------------------------------------------------------- #
# Sentinel switches to Supabase automatically when SUPABASE_URL and SUPABASE_KEY
# are both set. Leave them unset to use the local SQLite store under ./data.
#
# Values matching "your-*" are treated as unset, so it is safe to commit this
# file and copy it verbatim.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# REQUIRED in production for writes. The anon key cannot insert telemetry
# because row level security is enabled. Use the service_role key and keep it
# server-side only - never expose it to the browser or commit it.
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Keep true so local development works without Supabase. In production the
# Supabase repository is selected automatically, so this only matters as a
# safety net if Supabase is unreachable.
ENABLE_LOCAL_STORE=true

# --------------------------------------------------------------------------- #
# AI - optional. Without these the investigator uses a deterministic analyser,
# so every feature still works offline.
# --------------------------------------------------------------------------- #
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=45
LLM_TEMPERATURE=0.2
ENABLE_LLM=true

# Remote embeddings. When unset, the RAG store uses local embeddings instead.
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
ENABLE_RAG=true

# --------------------------------------------------------------------------- #
# Pipeline
# --------------------------------------------------------------------------- #
MONITORING_INTERVAL=5
ALERT_RISK_THRESHOLD=31
CONTAMINATION=0.05
MIN_TRAIN_SAMPLES=60
HISTORY_WINDOW=5000

# --------------------------------------------------------------------------- #
# RAG
# --------------------------------------------------------------------------- #
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SCORE=0.15

# --------------------------------------------------------------------------- #
# Telemetry agent ingest
# --------------------------------------------------------------------------- #
# Point the desktop agent at the deployed backend to stream real metrics.
AGENT_INGEST_URL=https://your-backend.onrender.com
AGENT_INGEST_KEY=your-agent-ingest-key
AGENT_UPDATE_INTERVAL=10
AGENT_MAX_RETRIES=3

# --------------------------------------------------------------------------- #
# Storage
# --------------------------------------------------------------------------- #
# Defaults to <repo>/data. On hosts with an ephemeral filesystem (Render free
# tier) point this at a mounted disk so SQLite and the vector store survive
# restarts.
SENTINEL_DATA_DIR=./data

# Pin telemetry to a single device. Leave unset to auto-detect.
SENTINEL_DEVICE_ID=

# --------------------------------------------------------------------------- #
# Demo mode - seeds synthetic telemetry so the UI has data on first run.
# Set to false in production once real devices report in.
# --------------------------------------------------------------------------- #
DEMO_MODE=true
