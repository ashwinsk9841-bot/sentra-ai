# ---------------------------------------------------------------------------
# SENTRA AI frontend configuration
# Copy to `.env.local` for development. Never commit real secrets.
# ---------------------------------------------------------------------------
#
# The browser never reads these values. They are consumed only by the
# server-side proxy at src/app/api/[...path]/route.ts, so the backend hostname
# and any credentials stay out of the client bundle.
#
# Nothing else is required: the UI calls same-origin `/api/*` and the proxy
# forwards to the backend. That is what makes the product a single URL.

# Origin of the SENTRA AI FastAPI backend (server-side only).
# Local:  python -m uvicorn sentinel.api.server:app --port 8787
# Prod:   the deployed backend, e.g. https://sentra-api.onrender.com
# Required in production; the proxy returns a clear 500 if it is missing.
SENTRA_API_URL=http://127.0.0.1:8787

# Timeout for GET requests (dashboard polls). 20s is ample.
SENTRA_API_TIMEOUT_MS=20000

# Timeout for POST requests. Investigations can call an LLM, which is slower
# than the backend's own LLM_TIMEOUT_S (default 45s), so this is longer.
SENTRA_API_WRITE_TIMEOUT_MS=60000
